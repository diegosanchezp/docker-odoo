<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">

        <record id="tax_iva_group" model="account.tax.group">
            <field name="name">IVA 16%</field>
            <field name="country_id" ref="base.ve" />
        </record>

        <record id="tax_iva_16_percent" model="account.tax">
            <field name="name">IVA 16%</field>
            <field name="description"></field>
            <field name="tax_group_id" ref="tax_iva_group"/>
            <field name="country_id" ref="base.ve" />
            <field name="company_id" ref="base.main_company" />
            <field name="amount">16</field>
            <field name="amount_type">percent</field>
        </record>

        <record id="tax_retencion_75_percent" model="account.tax">
            <field name="name">Retencion 75%</field>
            <field name="description">Retencion 75%</field>
            <field name="country_id" ref="base.ve" />
            <field name="company_id" ref="base.main_company" />
            <!-- 75%x16% = 12% -->
            <field name="amount">-12</field>
            <field name="amount_type">percent</field>
        </record>

        <record id="tax_retencion_group_75" model="account.tax">
            <field name="name">Retencion 75% sobre IVA 16% (12%)</field>
            <field name="description"></field>
            <field name="country_id" ref="base.ve" />
            <field name="company_id" ref="base.main_company" />
            <field name="amount">-75</field>
            <field name="amount_type">group</field>
            <field name="children_tax_ids" eval="[Command.link(ref('tax_iva_16_percent')), Command.link(ref('tax_retencion_75_percent'))]"/>
        </record>

        <record id="tax_retencion_100_percent" model="account.tax">
            <field name="name">Retencion 100%</field>
            <field name="description">Retencion 100%</field>
            <field name="country_id" ref="base.ve" />
            <field name="company_id" ref="base.main_company" />
            <!-- 100%x16% = 16% -->
            <field name="amount">-16</field>
            <field name="amount_type">percent</field>
        </record>

        <record id="tax_retencion_group_100" model="account.tax">
            <field name="name">Retencion 100% sobre IVA 16% (16%)</field>
            <field name="description"></field>
            <field name="country_id" ref="base.ve" />
            <field name="company_id" ref="base.main_company" />
            <field name="amount">-100</field>
            <field name="amount_type">group</field>
            <field name="children_tax_ids" eval="[Command.link(ref('tax_retencion_100_percent')), Command.link(ref('tax_iva_16_percent'))]"/>
        </record>
    </data>
</odoo>
